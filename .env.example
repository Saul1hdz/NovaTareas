# Copia este archivo como .env y completa solamente las integraciones que
# vayas a probar. Nunca envíes ni versiones el .env real.
#
# Genera secretos locales con:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"

# ── MÍNIMO PARA LA APP LOCAL ───────────────────────────────────
SECRET_KEY=genera-una-clave-local-larga-y-aleatoria

# Docker usa PostgreSQL automáticamente. Para ejecución nativa elige un motor:
DATABASE_ENGINE=postgres
DATABASE_URL=postgresql://novatareas:devpassword@127.0.0.1:5434/novatareas

# ── IA CON Z.AI ────────────────────────────────────────────────
ZAI_API_KEY=tu-api-key-de-zai
ZAI_MODEL=glm-4.5-flash

# Desactivado mientras no se haya validado un modelo de embeddings de z.ai.
# La recomendación de tareas sigue funcionando con el modelo de chat.
ZAI_EMB_ENABLED=false
# ZAI_EMB_MODEL=

# ── BOT DE TELEGRAM POR POLLING LOCAL ─────────────────────────
# Necesario al ejecutar: npm run bot:dev
TELEGRAM_BOT_TOKEN=tu-token-de-telegram

# ── OPCIONALES: SOLO ACTIVAR CUANDO SE PRUEBE ESA FUNCIÓN ─────

# SQLite queda disponible como rollback local: cambia DATABASE_ENGINE=sqlite.
# La ruta y los ajustes siguientes son opcionales.
# NOVATAREAS_DB_PATH=novatareas.db
# REMINDER_WINDOW_MINUTES=30
# APP_TIME_ZONE=America/El_Salvador

# Webhook HTTPS y endpoint cron. No se necesitan para bot:dev por polling.
# TELEGRAM_WEBHOOK_SECRET=genera-un-secreto-telegram-aleatorio
# CRON_SECRET=genera-otro-secreto-local-largo-y-aleatorio

# API externa POST /api/v1/recommend. No se necesita para usar el dashboard.
# No reutilices ZAI_API_KEY ni otra credencial del proveedor.
# AI_API_KEY=genera-una-clave-de-consumo-externo-larga-y-aleatoria
# AI_RATE_LIMIT_MAX=20
# AI_RATE_LIMIT_WINDOW=300000

# Ollama local como fallback. Déjalo comentado si Ollama no está instalado.
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:3b
# OLLAMA_EMB_MODEL=nomic-embed-text
#
# GEMINI_API_KEY solo aparece en herramientas manuales heredadas de embeddings.
# No se necesita para ejecutar la web, z.ai ni el bot de Telegram.

# Google Calendar. TOKEN_ENCRYPTION_KEY debe ser un valor base64url de 32 bytes.
# TOKEN_ENCRYPTION_KEY=genera-32-bytes-en-base64url
# GOOGLE_CLIENT_ID=tu-google-client-id
# GOOGLE_CLIENT_SECRET=tu-google-client-secret
# GOOGLE_REDIRECT_URI=http://localhost:4321/api/google/callback

# Ajustes opcionales de PostgreSQL.
# PG_POOL_MAX=10
# POSTGRES_PORT=5434
#
# El importador exige una copia SQLite explícita y hace rollback por defecto.
# SQLITE_MIGRATION_SOURCE=tmp/block4-baseline/novatareas-pre-bloque4.db
# SQLITE_MIGRATION_MODE=dry-run
