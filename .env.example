# Copia este archivo como .env y completa solamente las integraciones que
# vayas a probar. Nunca envíes ni versiones el .env real.
#
# Genera secretos locales con:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"

# ── MÍNIMO PARA LA APP LOCAL ───────────────────────────────────
SECRET_KEY=genera-una-clave-local-larga-y-aleatoria

# PostgreSQL es el único motor soportado. Sin DATABASE_URL la app no arranca.
DATABASE_URL=postgresql://novatareas:devpassword@127.0.0.1:5434/novatareas

# Base que usan las pruebas. El nombre DEBE terminar en `_test`: el setup borra
# su esquema completo en cada ejecución y se niega a tocar cualquier otra.
# Créala una vez con:
#   docker compose -f compose.dev.yml exec db createdb -U novatareas novatareas_test
TEST_DATABASE_URL=postgresql://novatareas:devpassword@127.0.0.1:5434/novatareas_test

# ── IA CON Z.AI ────────────────────────────────────────────────
ZAI_API_KEY=tu-api-key-de-zai
ZAI_MODEL=glm-4.5-flash

# Desactivado mientras no se haya validado un modelo de embeddings de z.ai.
# La recomendación de tareas sigue funcionando con el modelo de chat.
ZAI_EMB_ENABLED=false
# ZAI_EMB_MODEL=

# ── BOT DE TELEGRAM POR POLLING LOCAL ─────────────────────────
# Necesario al ejecutar: npm run bot:dev
TELEGRAM_BOT_TOKEN=tu-token-de-telegram

# ── OPCIONALES: SOLO ACTIVAR CUANDO SE PRUEBE ESA FUNCIÓN ─────

# El registro público está cerrado por defecto. Actívalo conscientemente y
# mantén el rate limit de PostgreSQL disponible.
# REGISTRATION_ENABLED=true

# REMINDER_WINDOW_MINUTES=30
# APP_TIME_ZONE=America/El_Salvador

# Webhook HTTPS y endpoint cron. No se necesitan para bot:dev por polling.
# TELEGRAM_WEBHOOK_SECRET=genera-un-secreto-telegram-aleatorio
# CRON_SECRET=genera-otro-secreto-local-largo-y-aleatorio

# API externa POST /api/v1/recommend. No se necesita para usar el dashboard.
# No reutilices ZAI_API_KEY ni otra credencial del proveedor.
# AI_API_KEY=genera-una-clave-de-consumo-externo-larga-y-aleatoria
# AI_RATE_LIMIT_MAX=20
# AI_RATE_LIMIT_WINDOW=300000

# Ollama local como fallback. Déjalo comentado si Ollama no está instalado.
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:3b
# OLLAMA_EMB_MODEL=nomic-embed-text

# Google Calendar. TOKEN_ENCRYPTION_KEY debe ser un valor base64url de 32 bytes.
# TOKEN_ENCRYPTION_KEY=genera-32-bytes-en-base64url
# GOOGLE_CLIENT_ID=tu-google-client-id
# GOOGLE_CLIENT_SECRET=tu-google-client-secret
# GOOGLE_REDIRECT_URI=http://localhost:4321/api/google/callback

# Ajustes opcionales de PostgreSQL.
# PG_POOL_MAX=10
# POSTGRES_PORT=5434

# ── SMTP: CORREO TRANSACCIONAL (verificación y recuperación) ──────────────
# En producción se usa el buzón dedicado en el Mailcow de la familia
# (novatareas@polarzero.dev). SMTP_HOST+SMTP_USER son obligatorios juntos;
# sin ellos, el envío queda desactivado y la verificación de correo no aplica.
# SMTP_HOST=mail.polarzero.dev
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=novatareas@polarzero.dev
# SMTP_PASS=tu-contrasena-del-buzon
# SMTP_FROM="NovaTareas <novatareas@polarzero.dev>"
#
# URL pública de la app para construir los enlaces de verificación/recuperación
# que van dentro del correo. En local usa http://127.0.0.1:4321.
# PUBLIC_APP_URL=https://novatareas.polarzero.dev
#
# Cuando es true, el registro exige confirmar el correo antes de iniciar sesión.
# Debe ir acompañado de SMTP configurado; si SMTP falta, el registro devuelve 503.
# EMAIL_VERIFICATION_REQUIRED=true

# ── SOLO PRODUCCIÓN (compose.prod.yml) ────────────────────────
# Ver docs/DESPLIEGUE.md antes de usarlas.
# REGISTRATION_ENABLED=false
# POSTGRES_PASSWORD=contrasena-exclusiva-del-servidor
# WEB_PORT=4321
# AVATAR_UPLOAD_DIR=/app/dist/client/avatars
# SEED_PASSWORD=clave-de-las-cuentas-de-demostracion
