{
  "name": "novatareas-pro",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "start": "astro start",
    "bot:dev": "node telegram/bot.js",
    "bot:scheduler": "node telegram/scheduler.js",
    "db:pg:generate": "drizzle-kit generate --config=drizzle.config.mjs",
    "db:pg:migrate": "node scripts/migrate-postgres.mjs",
    "db:pg:verify": "node scripts/verify-postgres-schema.mjs",
    "db:pg:check": "node scripts/check-postgres-service.mjs",
    "db:pg:smoke": "node scripts/smoke-postgres-runtime.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "astro check",
    "db:seed": "node scripts/seed-demo.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^11.0.2",
    "@astrojs/react": "^6.0.1",
    "astro": "^7.1.3",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.0.0",
    "drizzle-orm": "^0.45.2",
    "googleapis": "^173.0.0",
    "jose": "^6.2.3",
    "pg": "^8.21.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "@electric-sql/pglite": "^0.5.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.0.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "esbuild": "0.28.1"
  }
}
