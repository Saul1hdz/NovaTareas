---
const { title = 'NovaTareas Pro', theme = 'dark' } = Astro.props;
---
<!DOCTYPE html>
<html lang="es" data-theme={theme}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} · NovaTareas Pro</title>
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%237c6af7'/%3E%3Cpath d='M32 10l5.4 16.6L54 32l-16.6 5.4L32 54l-5.4-16.6L10 32l16.6-5.4z' fill='white'/%3E%3C/svg%3E" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=JetBrains+Mono:wght@300;400;500&display=swap" rel="stylesheet" />
  <style is:global>
    :root[data-theme="dark"] {
      --bg: #0b0b12;
      --bg2: #12121b;
      --bg3: #191922;
      --border: #23232f;
      --text: #ecebf5;
      --text2: #9a97b8;
      /* Antes decía `#5555778`, siete dígitos: un color inválido que el
         navegador descartaba, así que este nivel de texto heredaba el color
         del padre en lugar del gris tenue previsto. */
      --text3: #6b6889;
      --accent: #7c6af7;
      --accent2: #a392ff;
      --green: #34d399;
      --red: #f87171;
      --yellow: #fbbf24;
      --orange: #fb923c;
      --card-shadow: 0 1px 2px rgba(0,0,0,0.3);
      --glass: rgba(255,255,255,0.03);
      /* Superficie de fila y su estado al pasar el ratón. Se separan de --bg2
         porque las listas necesitan un contraste más suave que los paneles. */
      --row: #14141d;
      --row-hover: #1a1a25;
    }
    :root[data-theme="light"] {
      --bg: #f6f6fb;
      --bg2: #ffffff;
      --bg3: #eeeef6;
      --border: #e2e2ee;
      --text: #14142b;
      --text2: #5b5b7a;
      --text3: #8a8aa8;
      --accent: #6b58f0;
      --accent2: #8470ff;
      --green: #059669;
      --red: #dc2626;
      --yellow: #d97706;
      --orange: #ea580c;
      --card-shadow: 0 1px 2px rgba(20,20,43,0.06);
      --glass: rgba(0,0,0,0.02);
      --row: #ffffff;
      --row-hover: #f4f4fb;
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { font-size: 16px; scroll-behavior: smooth; }
    body {
      font-family: 'Syne', sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      transition: background 0.3s, color 0.3s;
    }
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: var(--bg); }
    ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 3px; }
    a { color: inherit; text-decoration: none; }
    button, input, select, textarea {
      font-family: inherit;
      font-size: inherit;
    }
    .mono { font-family: 'JetBrains Mono', monospace; }

    /* ── RESET BOTONES GLOBAL (evita estilos por defecto del navegador) ── */
    button {
      border: none;
      background: none;
      cursor: pointer;
      color: inherit;
      padding: 0;
      margin: 0;
      appearance: none;
      -webkit-appearance: none;
    }

    /* ── BOTONES DE TAREAS ──
       Discretos en reposo y con color solo al pasar el ratón. Antes cada
       tarjeta mostraba siete botones de colores saturados compitiendo con el
       título de la tarea, que es lo único que el usuario viene a leer. */
    .task-actions button {
      font-family: inherit;
      font-size: 0.78rem;
      font-weight: 600;
      border-radius: 7px !important;
      padding: 0.38rem 0.7rem !important;
      cursor: pointer;
      border: 1px solid transparent !important;
      background: transparent !important;
      color: var(--text2) !important;
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      transition: background 0.15s, color 0.15s, border-color 0.15s !important;
      box-shadow: none !important;
    }
    .task-actions button:hover {
      background: var(--bg3) !important;
      color: var(--text) !important;
      border-color: var(--border) !important;
    }
    /* Cada accion conserva su color, pero solo se revela al apuntarla: en
       reposo la fila se lee como texto, no como una botonera. */
    .task-actions .complete-btn:hover {
      background: rgba(52,211,153,0.14) !important;
      border-color: rgba(52,211,153,0.35) !important;
      color: var(--green) !important;
    }
    .task-actions .ai-btn:hover,
    .task-actions .useful-btn:hover {
      background: rgba(124,106,247,0.14) !important;
      border-color: rgba(124,106,247,0.38) !important;
      color: var(--accent2) !important;
    }
    .task-actions .archive-btn:hover {
      background: rgba(251,191,36,0.13) !important;
      border-color: rgba(251,191,36,0.35) !important;
      color: var(--yellow) !important;
    }
    .task-actions .collab-btn:hover {
      background: rgba(52,211,153,0.12) !important;
      border-color: rgba(52,211,153,0.32) !important;
      color: var(--green) !important;
    }
    .task-actions .del-btn:hover {
      background: rgba(248,113,113,0.14) !important;
      border-color: rgba(248,113,113,0.38) !important;
      color: var(--red) !important;
    }

    /* ── BOTONES CALENDARIO ── */
    .cal-today {
      background: var(--bg3) !important;
      border: 1px solid var(--border) !important;
      color: var(--text) !important;
      border-radius: 8px !important;
      padding: 0.45rem 1rem !important;
      font-size: 0.85rem !important;
      font-weight: 700 !important;
      transition: all 0.15s !important;
    }
    .cal-today:hover {
      background: var(--accent) !important;
      border-color: var(--accent) !important;
      color: white !important;
    }
    .cal-view-btn {
      background: transparent !important;
      border: none !important;
      color: var(--text2) !important;
      padding: 0.45rem 1rem !important;
      font-size: 0.82rem !important;
      font-weight: 700 !important;
      transition: all 0.15s !important;
    }
    .cal-view-btn.active {
      background: var(--accent) !important;
      color: white !important;
    }
    .cal-nav {
      background: var(--bg3) !important;
      border: 1px solid var(--border) !important;
      color: var(--text) !important;
      border-radius: 8px !important;
      padding: 0.4rem 0.75rem !important;
      font-size: 0.9rem !important;
    }

    /* ── BOTONES SIDEBAR ── */
    .nav-item {
      background: transparent !important;
      border: none !important;
      color: var(--text2) !important;
      border-radius: 8px !important;
      padding: 0.65rem 0.75rem !important;
      font-weight: 600 !important;
      font-size: 0.9rem !important;
      text-align: left !important;
      width: 100% !important;
      display: flex !important;
      align-items: center !important;
      gap: 0.6rem !important;
    }
    .nav-item:hover { background: var(--bg3) !important; color: var(--text) !important; }
    .nav-item.active { background: var(--accent) !important; color: white !important; }

    .label-chip {
      background: transparent !important;
      border: none !important;
      color: var(--text2) !important;
      padding: 0.4rem 0.75rem !important;
      border-radius: 6px !important;
      font-size: 0.85rem !important;
      text-align: left !important;
      width: 100% !important;
    }
    .label-chip:hover { background: var(--bg3) !important; color: var(--text) !important; }
    .label-chip.active { color: var(--accent) !important; font-weight: 600 !important; }

    .theme-toggle, .logout-btn {
      background: var(--bg3) !important;
      border: 1px solid var(--border) !important;
      color: var(--text2) !important;
      border-radius: 8px !important;
      padding: 0.5rem 0.75rem !important;
      font-size: 0.85rem !important;
      display: flex !important;
      align-items: center !important;
      gap: 0.5rem !important;
      width: 100% !important;
    }

    /* ── FILTROS ── */
    .filter-btn {
      background: var(--bg3) !important;
      border: 1px solid var(--border) !important;
      color: var(--text2) !important;
      border-radius: 20px !important;
      padding: 0.35rem 0.85rem !important;
      font-size: 0.82rem !important;
      font-weight: 600 !important;
    }
    .filter-btn.active { background: var(--accent) !important; border-color: var(--accent) !important; color: white !important; }
    .add-task-btn {
      background: var(--accent) !important;
      color: white !important;
      border: none !important;
      border-radius: 10px !important;
      padding: 0.6rem 1.2rem !important;
      font-weight: 700 !important;
      font-size: 0.9rem !important;
    }

    /* ── MODAL ── */
    .btn-primary {
      background: var(--accent) !important;
      color: white !important;
      border: none !important;
      border-radius: 8px !important;
      padding: 0.6rem 1.2rem !important;
      font-weight: 700 !important;
    }
    .btn-secondary {
      background: var(--bg3) !important;
      border: 1px solid var(--border) !important;
      color: var(--text2) !important;
      border-radius: 8px !important;
      padding: 0.6rem 1.1rem !important;
      font-weight: 600 !important;
    }
    .modal-close {
      background: none !important;
      border: none !important;
      color: var(--text2) !important;
      font-size: 1.2rem !important;
      padding: 0.2rem !important;
    }
    .menu-btn {
      background: none !important;
      border: none !important;
      color: var(--text2) !important;
      font-size: 1.3rem !important;
      padding: 0.25rem !important;
    }
    .task-check {
      background: rgba(255,255,255,0.03) !important;
      border: 1px solid rgba(255,255,255,0.08) !important;
      border-radius: 8px !important;
      width: 28px !important;
      height: 28px !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      flex-shrink: 0 !important;
      font-size: 0.95rem !important;
      font-weight: 700 !important;
    }
    .task-card.done .task-check {
      background: #22d47a !important;
      border-color: #22d47a !important;
      color: white !important;
    }

    /* ── AGENDA ── */
    .hidden { display: none !important; }
    .agenda-list {
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
      padding: 0.5rem 1.25rem 1rem;
    }
    .agenda-item {
      background: var(--bg3);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 0.9rem 1rem;
    }
    .agenda-item-title { font-weight: 700; font-size: 0.95rem; margin-bottom: 0.4rem; }
    .agenda-item-meta { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-bottom: 0.4rem; font-size: 0.8rem; color: var(--text2); align-items: center; }

    /* ── CALENDARIO TOOLBAR ── */
    .cal-toolbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.75rem 1.25rem 1rem;
      gap: 0.75rem;
      flex-wrap: wrap;
      border-bottom: 1px solid var(--border);
      margin-bottom: 1rem;
    }
    .cal-view-toggle {
      display: flex;
      background: var(--bg3);
      border: 1px solid var(--border);
      border-radius: 8px;
      overflow: hidden;
    }
    .cal-sync {
      background: var(--accent) !important;
      color: white !important;
      border: none !important;
      border-radius: 999px !important;
      padding: 0.55rem 0.9rem !important;
      font-size: 0.82rem !important;
      font-weight: 700 !important;
    }
    .cal-sync-status {
      background: rgba(66,133,244,0.12) !important;
      color: #4285F4 !important;
      border: 1px solid rgba(66,133,244,0.22) !important;
      border-radius: 999px !important;
      padding: 0.55rem 0.9rem !important;
      font-size: 0.82rem !important;
      font-weight: 700 !important;
    }
    .panel-toggle {
      background: var(--bg3) !important;
      border: 1px solid var(--border) !important;
      border-radius: 999px !important;
      padding: 0.45rem 0.85rem !important;
      color: var(--text2) !important;
      font-size: 0.82rem !important;
    }
  </style>
</head>
<body>
  <slot />
  <script>
    // Persist theme in localStorage
    const saved = localStorage.getItem('nt-theme');
    if (saved && document.documentElement.getAttribute('data-theme') !== saved) {
      document.documentElement.setAttribute('data-theme', saved);
    }
  </script>
</body>
</html>
