async function loadHistoryData(taskId) {
  try {
    const res  = await fetch(`/api/tasks/${taskId}/history`);
    if (!res.ok) throw new Error('Error al cargar historial');
    const data = await res.json();

    // Cambios automáticos
    const changesEl = document.getElementById('history-changes');
    if (!data.history?.length) {
      changesEl.innerHTML = '<em style="color:var(--text2)">Sin cambios registrados aún.</em>';
    } else {
      changesEl.innerHTML = data.history.map(h => `
        <div style="padding:.3rem 0;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:baseline;gap:.5rem;flex-wrap:wrap">
          <span>
            <span style="color:var(--accent);font-weight:600">${h.field}</span>:
            <span style="text-decoration:line-through;color:var(--text2);font-size:.8rem">${h.old_value || '—'}</span>
            → <strong>${h.new_value || '—'}</strong>
          </span>
          <span style="font-size:.74rem;color:var(--text2);white-space:nowrap">${formatDateShort(h.changed_at)}</span>
        </div>
      `).join('');
    }

    // Comentarios
    const commentsEl = document.getElementById('history-comments');
    if (!data.comments?.length) {
      commentsEl.innerHTML = '<em style="color:var(--text2)">Sin comentarios aún.</em>';
    } else {
      commentsEl.innerHTML = data.comments.map(c => `
        <div style="padding:.7rem .85rem;background:rgba(255,255,255,0.03);border-radius:10px;border:1px solid var(--border)">
          <div style="font-size:.75rem;color:var(--text2);margin-bottom:.3rem">${formatDateShort(c.created_at)}</div>
          <div style="color:var(--text);line-height:1.5">${escHtml(c.body)}</div>
          ${c.ai_reply ? `
            <div style="margin-top:.6rem;padding:.5rem .75rem;background:rgba(124,106,247,0.1);border-left:3px solid var(--accent);border-radius:0 8px 8px 0;font-size:.82rem;color:var(--text);line-height:1.5">
              🤖 ${escHtml(c.ai_reply)}
            </div>
          ` : ''}
        </div>
      `).join('');
    }
  } catch(err) {
    console.error('Error cargando historial:', err);
    document.getElementById('history-changes').innerHTML = '<em style="color:var(--red)">Error al cargar.</em>';
  }
}

async function submitComment(askAi) {
  const taskId = document.getElementById('history-task-id').value;
  const body   = document.getElementById('new-comment-body').value.trim();
  if (!body) return;

  const btn = document.getElementById(askAi ? 'btn-comment-ai' : 'btn-comment');
  if (btn) { btn.disabled = true; btn.textContent = askAi ? '⏳ Consultando IA...' : '⏳ Guardando...'; }

  try {
    await fetch(`/api/tasks/${taskId}/comments`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ body, ask_ai: askAi }),
    });
    document.getElementById('new-comment-body').value = '';
    await loadHistoryData(taskId);
  } catch(err) {
    alert('Error al guardar el comentario.');
  } finally {
    if (btn) {
      btn.disabled = false;
      btn.textContent = askAi ? '🤖 Comentar + IA' : '💬 Comentar';
    }
  }
}

async function saveQuickEdit() {
  const taskId   = document.getElementById('history-task-id').value;
  const priority = document.getElementById('edit-priority').value;
  const due_date = document.getElementById('edit-due-date').value || null;

  await fetch(`/api/tasks/${taskId}`, {
    method: 'PATCH',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ priority, due_date }),
  });
  document.getElementById('history-modal').classList.remove('open');
  loadTasks();
  if (currentView === 'archive') loadArchive();
}

async function unarchiveTask(id) {
  await fetch(`/api/tasks/${id}`, {
    method: 'PATCH',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ archived: false }),
  });
  loadArchive();
  loadTasks();
}

function formatDateShort(dateStr) {
  if (!dateStr) return '';
  try {
    return new Date(dateStr).toLocaleString('es-SV', {
      day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit'
    });
  } catch { return dateStr; }
}

window.openHistoryModal  = openHistoryModal;
window.closeHistoryModal = closeHistoryModal;
window.submitComment     = submitComment;
window.saveQuickEdit     = saveQuickEdit;
window.unarchiveTask     = unarchiveTask;
window.closeSidebar      = closeSidebar;
window.toggleSidebar     = toggleSidebar;
window.closeDayPanel     = closeDayPanel;
window.openDayPanel      = openDayPanel;

// ── INIT ──
loadTasks();
</script>