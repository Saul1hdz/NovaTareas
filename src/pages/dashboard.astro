<script define:vars={{ theme }}>
// ── STATE ──
let allTasks = [];
let archiveTasks = [];
let currentView = 'tasks';
let currentPriority = '';
let currentLabel = '';
let currentSearch = '';
let calDate = new Date();
let selectedDate = new Date().toISOString().split('T')[0];
let calendarView = 'month';
window.selectedDate = selectedDate;
let calendarItems = [];
let googleEvents = [];
let selectedDayTasks = [];
let dayPanelOpen = true;
let searchTimeout;

function toggleDayPanel() {
  dayPanelOpen = !dayPanelOpen;
  const panel = document.getElementById('day-panel');
  const icon = document.getElementById('day-panel-toggle-icon');
  const label = document.getElementById('day-panel-toggle-label');
  if (!panel || !icon || !label) return;
  // Toggle class for CSS, and also apply inline styles to force hide/show
  panel.classList.toggle('closed', !dayPanelOpen);
  const content = panel.querySelector('.day-panel-content');
  if (dayPanelOpen) {
    panel.style.maxHeight = '';
    if (content) { content.style.display = ''; }
    panel.setAttribute('aria-hidden', 'false');
  } else {
    panel.style.maxHeight = '76px';
    if (content) { content.style.display = 'none'; }
    panel.setAttribute('aria-hidden', 'true');
  }
  icon.textContent = dayPanelOpen ? '▾' : '▸';
  label.textContent = dayPanelOpen ? 'Ocultar detalles' : 'Ver detalles';
}

// ── SIDEBAR ──
function toggleSidebar() {
  const sb = document.getElementById('sidebar');
  const overlay = document.getElementById('sidebar-overlay');
  const main = document.querySelector('.main-content');
  const isMobile = window.innerWidth <= 768;

  if (isMobile) {
    const isOpen = sb.classList.contains('open');
    sb.classList.toggle('open', !isOpen);
    overlay.classList.toggle('visible', !isOpen);
    document.body.style.overflow = isOpen ? '' : 'hidden';
  } else {
    sb.classList.toggle('collapsed');
    main.classList.toggle('expanded');
  }
}

function closeSidebar() {
  const sb = document.getElementById('sidebar');
  const overlay = document.getElementById('sidebar-overlay');
  sb.classList.remove('open');
  overlay.classList.remove('visible');
  document.body.style.overflow = '';
}

window.addEventListener('resize', () => {
  if (window.innerWidth > 768) closeSidebar();
});

// ── THEME ──
let currentTheme = theme;
async function toggleTheme() {
  currentTheme = currentTheme === 'dark' ? 'light' : 'dark';
  document.documentElement.setAttribute('data-theme', currentTheme);
  localStorage.setItem('nt-theme', currentTheme);
  document.getElementById('theme-icon').textContent = currentTheme === 'dark' ? '☀' : '☾';
  document.getElementById('theme-label').textContent = currentTheme === 'dark' ? 'Modo claro' : 'Modo oscuro';
  await fetch('/api/theme', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ theme: currentTheme })
  });
}

// ── VIEWS ──
function setView(v) {
  currentView = v;
  document.querySelectorAll('.view').forEach(el => el.classList.remove('active'));
  document.getElementById('view-' + v).classList.add('active');
  document.querySelectorAll('.nav-item').forEach(el => el.classList.remove('active'));
  document.getElementById('nav-' + v).classList.add('active');
  if (v === 'archive') loadArchive();
  if (v === 'calendar') loadCalendarTasks();
}

// ── FILTERS ──
function setPriority(p) {
  currentPriority = p;
  document.querySelectorAll('.filter-btn').forEach(b => {
    b.classList.toggle('active', b.dataset.p === p);
  });
  loadTasks();
}

function filterByLabel(l) {
  currentLabel = currentLabel === l ? '' : l;
  document.querySelectorAll('.label-chip').forEach(c => {
    c.classList.toggle('active', c.textContent === l && currentLabel === l);
  });
  loadTasks();
}

function debouncedSearch() {
  clearTimeout(searchTimeout);
  searchTimeout = setTimeout(() => {
    currentSearch = document.getElementById('search-input').value;
    loadTasks();
  }, 300);
}

// ── LOAD TASKS ──
async function loadTasks() {
  const params = new URLSearchParams({ archived: '0' });
  if (currentSearch) params.set('q', currentSearch);
  if (currentLabel) params.set('label', currentLabel);
  if (currentPriority) params.set('priority', currentPriority);

  const res = await fetch('/api/tasks?' + params);
  allTasks = await res.json();
  renderTasks(allTasks, 'tasks-list');
  updateStats();
  updateAdvisor(allTasks);
  if (currentView === 'calendar') {
    await loadCalendarTasks();
  }
}

async function loadArchive() {
  const res = await fetch('/api/tasks?archived=1');
  archiveTasks = await res.json();
  renderTasks(archiveTasks, 'archive-list', true);
}

// ── RENDER TASKS ──
function markdownToHtml(text) {
  return text
    .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
    .replace(/\*(.*?)\*/g, '<em>$1</em>')
    .replace(/\n/g, '<br>');
}
function toggleArchiveCard(id) {
  const card = document.getElementById(`archive-card-${id}`);
  if (!card) return;

  card.classList.toggle("expanded");
}
function renderTasks(tasks, containerId, isArchive = false) {
  const container = document.getElementById(containerId);

  if (!tasks.length) {
    container.innerHTML = `
      <div class="empty-state">
        ${isArchive ? "El archivo está vacío" : "Sin tareas pendientes"}
      </div>
    `;
    return;
  }

  container.innerHTML = tasks.map(t => {

    const isDone = t.status === "completada";

    const normalDate = normalizeDueDateStr(t.due_date);

    const dueDateMs = normalDate
      ? new Date(normalDate + "T12:00:00").getTime()
      : null;

    const isOverdue =
      dueDateMs &&
      dueDateMs < Date.now() &&
      !isDone;

    const dueLabel = normalDate
      ? new Date(normalDate + "T12:00:00").toLocaleDateString(
          "es",
          {
            month: "short",
            day: "numeric"
          }
        )
      : "";

    const subtasksHtml =
      t.subtasks?.length
        ? `
        <div class="ai-result-box">

          <div class="ai-recs-header">
             Recomendación Para Iniciar
          </div>

          ${t.subtasks
            .map(
              s => `
            <div class="subtask-item">

              <div class="subtask-text ${s.done ? "checked" : ""}">
                ${markdownToHtml(escHtml(s.text))}
              </div>

            </div>
          `
            )
            .join("")}

        </div>
      `
        : "";

    // ===========================
    // VISTA ARCHIVADOS
    // ===========================

    if (isArchive) {

      return `

      <div
        class="archive-card p-${t.priority}"
        id="archive-card-${t.id}"
      >

        <div
          class="archive-header"
          onclick="toggleArchiveCard(${t.id})"
        >

          <div class="archive-title">

             ${escHtml(t.title)}

          </div>

          <button class="archive-expand">

            ▼

          </button>

        </div>

        <div class="archive-content">

          <div class="archive-info">

            <span class="badge badge-${t.priority}">
              ${t.priority}
            </span>

            ${
              normalDate
                ? `<span class="badge badge-due">${dueLabel}</span>`
                : ""
            }

          </div>

          ${
            t.description
              ? `
              <div class="task-desc">

                ${escHtml(t.description)}

              </div>
            `
              : ""
          }

          ${
            t.what_worked
              ? `
              <h4> Qué salió bien</h4>

              <div class="task-desc">

                ${escHtml(t.what_worked)}

              </div>
            `
              : ""
          }

          ${
            t.what_failed
              ? `
              <h4> Qué salió mal</h4>

              <div class="task-desc">

                ${escHtml(t.what_failed)}

              </div>
            `
              : ""
          }

          ${
            t.observations
              ? `
              <h4> Observaciones</h4>

              <div class="task-desc">

                ${escHtml(t.observations)}

              </div>
            `
              : ""
          }

          ${
            t.archive_comments
              ? `
              <h4> Comentarios</h4>

              <div class="task-desc">

                ${escHtml(t.archive_comments)}

              </div>
            `
              : ""
          }

          ${subtasksHtml}

          <div class="task-actions">

            <button
              class="complete-btn"
              onclick="unarchiveTask(${t.id})"
            >
              Reabrir
            </button>

            <button
              class="history-btn"
              onclick="openHistoryModal(${t.id}, \`${escHtml(t.title)}\`)"
            >
               Historial
            </button>

            <button
              class="del-btn"
              onclick="deleteTask(${t.id})"
            >
              Borrar
            </button>

          </div>

        </div>

      </div>

      `;
    }


    return `

      <div class="task-card p-${t.priority} ${isDone ? "done" : ""} ${isOverdue ? "overdue" : ""}" id="card-${t.id}">

        <div class="task-frame">

          <div class="task-tab">

            <button
              class="task-check"
