function renderCalendar() {
  const grid = document.getElementById('cal-grid');
  const year = calDate.getFullYear();
  const month = calDate.getMonth();
  const today = new Date();

  const monthNames = ['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];
  const dayNames = ['Dom','Lun','Mar','Mié','Jue','Vie','Sáb'];

  const firstDay = new Date(year, month, 1).getDay();
  const daysInMonth = new Date(year, month + 1, 0).getDate();
  const daysInPrev = new Date(year, month, 0).getDate();

  const taskMap = {};
  console.log('[renderCalendar] calendarItems.length:', calendarItems.length);
  calendarItems.forEach(t => {
    const dateKey = normalizeDueDateStr(t.due_date);
    console.log('[renderCalendar] t.due_date:', t.due_date, '-> dateKey:', dateKey);
    if (dateKey) {
      if (!taskMap[dateKey]) taskMap[dateKey] = [];
      taskMap[dateKey].push(t);
    }
  });
  console.log('[renderCalendar] taskMap:', taskMap);

  document.getElementById('cal-month-title').textContent = `${monthNames[month]} ${year}`;
  let html = `${dayNames.map(d => `<div class="cal-day-name">${d}</div>`).join('')}`;

  for (let i = firstDay - 1; i >= 0; i--) {
    html += `<div class="cal-day other-month"><div class="cal-day-num">${daysInPrev - i}</div></div>`;
  }

  for (let d = 1; d <= daysInMonth; d++) {
    const dateStr = `${year}-${String(month+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
    const isToday = today.getFullYear() === year && today.getMonth() === month && today.getDate() === d;
    const dayTasks = taskMap[dateStr] || [];
    const isSelected = selectedDate === dateStr;
    html += `<div class="cal-day ${isToday ? 'today' : ''} ${dayTasks.length ? 'has-tasks' : ''} ${isSelected ? 'selected' : ''}" onclick="selectCalendarDay('${dateStr}')">
      <div class="cal-day-num">${d}</div>
      ${dayTasks.length ? `
  <div class="cal-dots" title="${dayTasks.length} evento${dayTasks.length !== 1 ? 's' : ''}">
    ${dayTasks.map(t => `
      <span
        class="cal-dot p-${t.priority}"
        title="${escHtml(t.title)}"
      ></span>
    `).join("")}
  </div>
` : ""}
    </div>`;
  }

  const total = firstDay + daysInMonth;
  const remaining = total % 7 === 0 ? 0 : 7 - (total % 7);
  for (let i = 1; i <= remaining; i++) {
    html += `<div class="cal-day other-month"><div class="cal-day-num">${i}</div></div>`;
  }

  grid.innerHTML = html;
}

