// ── FILTERS ──
function setPriority(p) {
  currentPriority = p;
  if (p === '') {
    currentLabel = '';
    document.querySelectorAll('.label-chip').forEach(chip => {
      chip.classList.remove('active');
    });
  }
  document.querySelectorAll('.filter-btn').forEach(b => {
    b.classList.toggle('active', b.dataset.p === p);
  });
  loadTasks();
}

function filterByLabel(l) {
  currentLabel = currentLabel === l ? '' : l;
  document.querySelectorAll('.label-chip').forEach(c => {
    c.classList.toggle('active', c.textContent === l && currentLabel === l);
  });
  loadTasks();
}

document.querySelectorAll('#labels-list .label-chip').forEach(button => {
  button.addEventListener('click', () => filterByLabel(button.dataset.label || ''));
});

window.addEventListener('pageshow', event => {
  if (event.persisted) window.location.reload();
});

function debouncedSearch() {
  clearTimeout(searchTimeout);
  searchTimeout = setTimeout(() => {
    currentSearch = document.getElementById('search-input').value;
    loadTasks();
  }, 300);
}

// ── LOAD TASKS ──
async function loadTasks() {
  const params = new URLSearchParams({ archived: '0' });
  if (currentSearch) params.set('q', currentSearch);
  if (currentLabel) params.set('label', currentLabel);
  if (currentPriority) params.set('priority', currentPriority);

  const res = await fetch('/api/tasks?' + params);
  allTasks = await res.json();
  renderTasks(allTasks, 'tasks-list');
  updateStats();
  updateAdvisor(allTasks);
  if (currentView === 'calendar') {
    await loadCalendarTasks();
  }
}

async function loadArchive() {
  const res = await fetch('/api/tasks?archived=1');
  archiveTasks = await res.json();
  renderTasks(archiveTasks, 'archive-list', true);
}

// ── RENDER TASKS ──
function toggleArchiveCard(id) {
  const card = document.getElementById(`archive-card-${id}`);
  if (!card) return;

  card.classList.toggle("expanded");
}
function renderTasks(tasks, containerId, isArchive = false) {
  const container = document.getElementById(containerId);
  container.replaceChildren();

  if (!tasks.length) {
    container.appendChild(createTextElement(
      'div',
      'empty-state',
      isArchive ? 'El archivo está vacío' : 'Sin tareas pendientes'
    ));
    return;
  }

  tasks.forEach(t => {
    const isDone = t.status === "completada";
    const normalDate = normalizeDueDateStr(t.due_date);
    const dueDateMs = normalDate
      ? new Date(normalDate + "T12:00:00").getTime()
      : null;
    const isOverdue =
      dueDateMs &&
      dueDateMs < Date.now() &&
      !isDone;
    const dueLabel = normalDate
      ? new Date(normalDate + "T12:00:00").toLocaleDateString(
          "es",
          { month: "short", day: "numeric" }
        )
      : "";

    if (isArchive) {
      const card = document.createElement('div');
      card.className = `archive-card p-${t.priority}`;
      card.id = `archive-card-${t.id}`;

      const header = document.createElement('div');
      header.className = 'archive-header';
      header.append(
        createTextElement('div', 'archive-title', t.title),
        createTextElement('button', 'archive-expand', '▼')
      );
      header.addEventListener('click', () => toggleArchiveCard(t.id));
      card.appendChild(header);

      const content = document.createElement('div');
      content.className = 'archive-content';
      const info = document.createElement('div');
      info.className = 'archive-info';
      info.appendChild(createTextElement('span', `badge badge-${t.priority}`, t.priority));
      if (normalDate) {
        info.appendChild(createTextElement('span', 'badge badge-due', dueLabel));
      }
      appendCollabBadges(info, t);
      content.appendChild(info);
      appendTaskText(content, null, t.description);
      appendTaskText(content, 'Qué salió bien', t.what_worked);
      appendTaskText(content, 'Qué salió mal', t.what_failed);
      appendTaskText(content, 'Observaciones', t.observations);
      appendTaskText(content, 'Comentarios', t.archive_comments);
      appendSubtasks(content, t.subtasks);
      appendRecommendation(content, t.recommendation);

      const actions = document.createElement('div');
      actions.className = 'task-actions';
      if (isOwnerOf(t)) {
        actions.appendChild(createActionButton('complete-btn', 'Reabrir', () => unarchiveTask(t.id)));
      }
      actions.appendChild(createActionButton('history-btn', 'Historial', () => openHistoryModal(t.id)));
      actions.appendChild(createActionButton('collab-btn', 'Equipo', () => openCollabModal(t.id)));
      if (isOwnerOf(t)) {
        actions.appendChild(createActionButton('del-btn', 'Borrar', () => deleteTask(t.id)));
      }
      content.appendChild(actions);
      card.appendChild(content);
      container.appendChild(card);
      return;
    }

    const card = document.createElement('div');
    card.className = `task-card p-${t.priority}${isDone ? ' done' : ''}${isOverdue ? ' overdue' : ''}`;
    card.id = `card-${t.id}`;
    const frame = document.createElement('div');
    frame.className = 'task-frame';
    const tab = document.createElement('div');
    tab.className = 'task-tab';
    tab.appendChild(createActionButton(
      'task-check',
      isDone ? '✓' : '',
      () => toggleTask(t.id, t.status)
    ));

    const taskInfo = document.createElement('div');
    taskInfo.className = 'task-info';
    taskInfo.appendChild(createTextElement('div', 'task-title', t.title));
    tab.appendChild(taskInfo);

    const badges = document.createElement('div');
    badges.style.cssText = 'margin-left:auto;display:flex;gap:.5rem;align-items:center';
    badges.appendChild(createTextElement('span', `badge badge-${t.priority}`, t.priority));
    if (normalDate) {
      badges.appendChild(createTextElement(
        'span',
        `badge ${isOverdue ? 'badge-overdue' : 'badge-due'}`,
        dueLabel
      ));
    }
    appendCollabBadges(badges, t);
    tab.appendChild(badges);
    frame.appendChild(tab);

    const body = document.createElement('div');
    body.className = 'task-body';
    appendTaskText(body, null, t.description);
    appendSubtasks(body, t.subtasks);
    appendRecommendation(body, t.recommendation);

    // Los botones se pintan según el nivel real del usuario en la tarea: a un
    // lector no se le ofrece un botón que la API le va a rechazar.
    const actions = document.createElement('div');
    actions.className = 'task-actions';
    if (canEdit(t)) {
      actions.appendChild(createActionButton(
        'complete-btn',
        isDone ? 'Reabrir' : 'Terminada',
        () => toggleTask(t.id, t.status)
      ));
    }
    if (canComment(t)) {
      actions.appendChild(createActionButton('ai-btn', 'Consejos', () => genAI(t.id)));
    }
    if (isOwnerOf(t)) {
      actions.appendChild(createActionButton(
        'archive-btn',
        isDone ? 'Archivar' : 'Arch',
        () => archiveTask(t.id)
      ));
    }
    actions.appendChild(createActionButton('history-btn', 'Historial', () => openHistoryModal(t.id)));
    actions.appendChild(createActionButton('collab-btn', 'Equipo', () => openCollabModal(t.id)));
    if (isOwnerOf(t)) {
      actions.appendChild(createActionButton('del-btn', 'Borrar', () => deleteTask(t.id)));
    }
    body.appendChild(actions);
    frame.appendChild(body);
    card.appendChild(frame);
    container.appendChild(card);
  });
}

// ── MODO COLABORATIVO: niveles ──
// El servidor manda `my_role` con cada tarea; aquí solo se decide qué se pinta.
// La API vuelve a comprobar el nivel en cada petición: esto es comodidad, no
// seguridad.
const ROLE_LABELS = {
  propietario: 'Propietario',
  editor: 'Editor',
  comentarista: 'Comentarista',
  lector: 'Lector',
};
const ROLE_ORDER = { lector: 1, comentarista: 2, editor: 3, propietario: 4 };

function roleOf(task) {
  return task.my_role || 'propietario';
}
function isOwnerOf(task) {
  return task.is_owner !== false;
}
function canEdit(task) {
  return (ROLE_ORDER[roleOf(task)] || 0) >= ROLE_ORDER.editor;
}
function canComment(task) {
  return (ROLE_ORDER[roleOf(task)] || 0) >= ROLE_ORDER.comentarista;
}

function appendCollabBadges(parent, task) {
  const collaborators = Number(task.collaborator_count || 0);

  if (!isOwnerOf(task)) {
    parent.appendChild(createTextElement(
      'span',
      'badge badge-role',
      `Compartida · ${ROLE_LABELS[roleOf(task)] || roleOf(task)}`
    ));
  }

  if (collaborators > 0) {
    parent.appendChild(createTextElement(
      'span',
      'badge badge-team',
      `👥 ${collaborators + 1}`
    ));
  } else if (isOwnerOf(task) && task.visibility === 'privada') {
    parent.appendChild(createTextElement('span', 'badge badge-private', '🔒 Privada'));
  }
}

function createTextElement(tag, className, text) {
  const element = document.createElement(tag);
  if (className) element.className = className;
  element.textContent = text == null ? '' : String(text);
  return element;
}

function createActionButton(className, label, handler) {
  const button = createTextElement('button', className, label);
  button.type = 'button';
  button.addEventListener('click', handler);
  return button;
}

function appendTaskText(parent, heading, value) {
  if (!value) return;
  if (heading) parent.appendChild(createTextElement('h4', '', heading));
  parent.appendChild(createTextElement('div', 'task-desc', value));
}

// Las subtareas son pasos reales que el usuario escribe y marca. Antes esta
// función pintaba también la recomendación de la IA, porque ambas cosas
// compartían tabla; ahora cada una tiene su propio bloque.
function appendSubtasks(parent, subtasks) {
  if (!subtasks?.length) return;
  const box = document.createElement('div');
  box.className = 'ai-result-box';
  box.appendChild(createTextElement('div', 'ai-recs-header', 'Subtareas'));
  subtasks.forEach(subtask => {
    const item = document.createElement('div');
    item.className = 'subtask-item';
    item.appendChild(createTextElement(
      'div',
      `subtask-text${subtask.done ? ' checked' : ''}`,
      subtask.text
    ));
    box.appendChild(item);
  });
  parent.appendChild(box);
}

const RECOMMENDATION_SOURCES = {
  zai: 'IA (z.ai)',
  ollama: 'IA local (Ollama)',
  history: 'Tu historial de tareas archivadas',
  rules: 'Sugerencia general',
};

function appendRecommendation(parent, recommendation) {
  if (!recommendation?.text) return;
  const box = document.createElement('div');
  box.className = 'ai-result-box';
  box.appendChild(createTextElement(
    'div',
    'ai-recs-header',
    `Recomendación Para Iniciar · ${RECOMMENDATION_SOURCES[recommendation.source] || 'Sugerencia'}`
  ));
  const item = document.createElement('div');
  item.className = 'subtask-item';
  item.appendChild(createTextElement('div', 'subtask-text', recommendation.text));
  box.appendChild(item);
  parent.appendChild(box);
}

// ── STATS ──
function updateStats() {
  const total = allTasks.length;
  const done = allTasks.filter(t => t.status === 'completada').length;
  const active = total - done;
  const urgent = allTasks.filter(t => t.priority === 'urgente' && t.status !== 'completada').length;
  const today = new Date().toISOString().split('T')[0];
  const overdue = allTasks.filter(t => t.due_date && t.due_date < today && t.status !== 'completada').length;
  const pct = total > 0 ? Math.round(done / total * 100) : 0;

  document.getElementById('stat-total').textContent = active;
  document.getElementById('stat-done').textContent = done;
  document.getElementById('stat-urgent').textContent = urgent;
  document.getElementById('stat-overdue').textContent = overdue;
  document.getElementById('ring-pct').textContent = pct + '%';
  const circle = document.querySelector('.progress-ring circle:last-child');
  if (circle) {
    circle.setAttribute('stroke-dashoffset', 150.8 * (1 - done / (total || 1)));
  }
}

// ── TASK ACTIONS ──
async function toggleTask(id, status) {
  const newStatus = status === 'completada' ? 'pendiente' : 'completada';
  await fetch(`/api/tasks/${id}`, {
    method: 'PATCH',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ status: newStatus })
  });
  loadTasks();
}

async function archiveTask(id) {
  // Abrir modal de observaciones antes de archivar
  const modal = document.getElementById('archive-modal');
  if (modal) {
    document.getElementById('archive-task-id').value = id;
    document.getElementById('archive-observations').value = '';
    document.getElementById('archive-what-worked').value = '';
    document.getElementById('archive-what-failed').value = '';
    modal.classList.add('open');
    return;
  }
  // Fallback sin modal
  await fetch(`/api/tasks/${id}`, {
    method: 'PATCH',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ archived: true })
  });
  loadTasks();
}
 
async function confirmArchive() {
  const id = document.getElementById('archive-task-id').value;
  const observations = document.getElementById('archive-observations').value.trim();
  const what_worked = document.getElementById('archive-what-worked').value.trim();
  const what_failed = document.getElementById('archive-what-failed').value.trim();
 
  await fetch(`/api/tasks/${id}`, {
    method: 'PATCH',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ archived: true, observations, what_worked, what_failed })
  });
 
  document.getElementById('archive-modal').classList.remove('open');
  loadTasks();
}
 
window.confirmArchive = confirmArchive;

async function deleteTask(id) {
  if (!confirm('¿Eliminar esta tarea?')) return;
  await fetch(`/api/tasks/${id}`, { method: 'DELETE' });
  loadTasks();
}

async function toggleSubtask(taskId, subId) {
  await fetch(`/api/tasks/${taskId}/subtasks/${subId}`, { method: 'PATCH' });
  loadTasks();
}

// ── AI ──
async function genAI(taskId) {
  const card = document.getElementById('card-' + taskId);
  const btn = card?.querySelector('.ai-btn');
  if (btn) { btn.disabled = true; btn.textContent = '⏳ Analizando...'; }

  let subtaskDiv = card?.querySelector('.ai-result-box');
  if (!subtaskDiv) {
    subtaskDiv = document.createElement('div');
    subtaskDiv.className = 'ai-result-box';
    card.querySelector('.task-actions').before(subtaskDiv);
  }
  const loading = document.createElement('div');
  loading.className = 'ai-generating';
  loading.append(
    createTextElement('div', 'spinner', ''),
    document.createTextNode(' El asistente está analizando tu tarea...')
  );
  subtaskDiv.replaceChildren(loading);

  const controller = new AbortController();
  const timeoutId = setTimeout(() => controller.abort(), 50000);

  try {
    const res = await fetch(`/api/tasks/${taskId}/ai`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: '{}',
      signal: controller.signal
    });
    const contentType = res.headers.get('content-type') || '';
    const data = contentType.includes('application/json')
      ? await res.json()
      : null;

    if (!res.ok) {
      const message = data?.error || `Error del servidor (HTTP ${res.status}).`;
      throw new Error(message);
    }

    await loadTasks();
  } catch (error) {
    const message = error?.name === 'AbortError'
      ? 'El asistente tardó demasiado. Intenta nuevamente.'
      : error?.message || 'No se pudo obtener la recomendación.';
    const errorBox = createTextElement('div', '', `⚠️ ${message}`);
    errorBox.style.cssText = 'color:var(--red);font-size:.82rem;padding:.5rem 0';
    subtaskDiv.replaceChildren(errorBox);
  } finally {
    clearTimeout(timeoutId);
    if (btn) { btn.disabled = false; btn.textContent = ' Consejos'; }
  }
}

// ── CREATE TASK ──
function openModal() {
  document.getElementById('modal').classList.add('open');
  document.getElementById('new-title').focus();
}
function closeModal(e) {
  if (e && e.target !== document.getElementById('modal')) return;
  document.getElementById('modal').classList.remove('open');
  document.getElementById('modal-error').textContent = '';
}

async function createTask() {
  const title = document.getElementById('new-title').value.trim();
  if (!title) { document.getElementById('modal-error').textContent = 'El título es requerido'; return; }

  const res = await fetch('/api/tasks', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      title,
      description: document.getElementById('new-desc').value,
      priority: document.getElementById('new-priority').value,
      label: document.getElementById('new-label').value,
      due_date: document.getElementById('new-duedate').value || null,
      visibility: document.getElementById('new-collaborative').checked
        ? 'colaborativa'
        : 'privada'
    })
  });
  if (res.ok) {
    const created = await res.json();
    const wasCollaborative = document.getElementById('new-collaborative').checked;
    document.getElementById('modal').classList.remove('open');
    document.getElementById('new-title').value = '';
    document.getElementById('new-desc').value = '';
    document.getElementById('new-label').value = '';
    document.getElementById('new-duedate').value = '';
    document.getElementById('new-priority').value = 'media';
    document.getElementById('new-collaborative').checked = false;
    currentLabel = '';
    document.querySelectorAll('.label-chip').forEach(chip => {
      chip.classList.remove('active');
    });
    await loadTasks();
    updateLabelsList();
    // Marcar "modo colaborativo" solo sirve si a continuación se puede invitar,
    // así que el panel de equipo se abre con la tarea recién creada.
    if (wasCollaborative && created?.id) openCollabModal(created.id);
  } else {
    const data = await res.json();
    document.getElementById('modal-error').textContent = data.error;
  }
}

async function updateLabelsList() {
  const res = await fetch('/api/tasks?archived=0');
  const tasks = await res.json();
  const labels = [...new Set(tasks.map(t => t.label).filter(Boolean))].sort();
  const list = document.getElementById('labels-list');
  list.replaceChildren(...labels.map(label => {
    const button = document.createElement('button');
    button.className = `label-chip ${label === currentLabel ? 'active' : ''}`;
    button.textContent = label;
    button.addEventListener('click', () => filterByLabel(label));
    return button;
  }));
}


function normalizeDueDateStr(due_date) {
  if (!due_date) return null;
  const s = String(due_date);
  if (/^\d{4}-\d{2}-\d{2}$/.test(s)) return s;
  const num = Number(s);
  if (!isNaN(num) && num > 1000000000000) {
    return new Date(num).toISOString().split('T')[0];
  }
  return null;
}

async function loadCalendarTasks() {
  const res = await fetch(`/api/tasks?archived=0`);
  const tasks = res.ok ? await res.json() : [];

  calendarItems = tasks.map(t => ({ ...t, due_date: normalizeDueDateStr(t.due_date) || t.due_date, _source: 'task' }));

  renderCalendar();
  selectCalendarDay(selectedDate);
  if (calendarView === 'agenda') renderAgenda();
}

function setCalendarView(view) {
  calendarView = view;
  document.getElementById('view-month-btn').classList.toggle('active', view === 'month');
  document.getElementById('view-agenda-btn').classList.toggle('active', view === 'agenda');
  document.getElementById('cal-grid').classList.toggle('hidden', view !== 'month');
  document.getElementById('agenda-list').classList.toggle('hidden', view !== 'agenda');
  if (view === 'agenda') renderAgenda();
}

function renderCalendar() {
  const grid = document.getElementById('cal-grid');
  const year = calDate.getFullYear();
  const month = calDate.getMonth();
  const today = new Date();

  const monthNames = ['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];
  const dayNames = ['Dom','Lun','Mar','Mié','Jue','Vie','Sáb'];

  const firstDay = new Date(year, month, 1).getDay();
  const daysInMonth = new Date(year, month + 1, 0).getDate();
  const daysInPrev = new Date(year, month, 0).getDate();

  const taskMap = {};
  calendarItems.forEach(t => {
    const dateKey = normalizeDueDateStr(t.due_date);
    if (dateKey) {
      if (!taskMap[dateKey]) taskMap[dateKey] = [];
      taskMap[dateKey].push(t);
    }
  });

  document.getElementById('cal-month-title').textContent = `${monthNames[month]} ${year}`;
  grid.replaceChildren();
  dayNames.forEach(dayName => {
    grid.appendChild(createTextElement('div', 'cal-day-name', dayName));
  });

  for (let i = firstDay - 1; i >= 0; i--) {
    const day = document.createElement('div');
    day.className = 'cal-day other-month';
    day.appendChild(createTextElement('div', 'cal-day-num', daysInPrev - i));
    grid.appendChild(day);
  }

  for (let d = 1; d <= daysInMonth; d++) {
    const dateStr = `${year}-${String(month+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
    const isToday = today.getFullYear() === year && today.getMonth() === month && today.getDate() === d;
    const dayTasks = taskMap[dateStr] || [];
    const isSelected = selectedDate === dateStr;
    const day = document.createElement('div');
    day.className = `cal-day${isToday ? ' today' : ''}${dayTasks.length ? ' has-tasks' : ''}${isSelected ? ' selected' : ''}`;
    day.addEventListener('click', () => selectCalendarDay(dateStr));
    day.appendChild(createTextElement('div', 'cal-day-num', d));

    if (dayTasks.length) {
      const dots = document.createElement('div');
      dots.className = 'cal-dots';
      dots.title = `${dayTasks.length} evento${dayTasks.length !== 1 ? 's' : ''}`;
      dayTasks.forEach(task => {
        const dot = document.createElement('span');
        dot.className = `cal-dot p-${task.priority}`;
        dot.title = task.title;
        dots.appendChild(dot);
      });
      day.appendChild(dots);
    }
    grid.appendChild(day);
  }

  const total = firstDay + daysInMonth;
  const remaining = total % 7 === 0 ? 0 : 7 - (total % 7);
  for (let i = 1; i <= remaining; i++) {
    const day = document.createElement('div');
    day.className = 'cal-day other-month';
    day.appendChild(createTextElement('div', 'cal-day-num', i));
    grid.appendChild(day);
  }
}

async function selectCalendarDay(date) {
  selectedDate = date;
  window.selectedDate = selectedDate;
  renderCalendar();
  selectedDayTasks = calendarItems.filter(item => normalizeDueDateStr(item.due_date) === date);
  renderDayDetails();
  if (window.innerWidth <= 768) openDayPanel();
}

function openDayPanel() {
  document.getElementById('day-panel').classList.add('mobile-open');
  const ov = document.getElementById('day-panel-overlay');
  if (ov) { ov.style.display = 'block'; ov.classList.add('visible'); }
  document.body.style.overflow = 'hidden';
}

function closeDayPanel() {
  document.getElementById('day-panel').classList.remove('mobile-open');
  const ov = document.getElementById('day-panel-overlay');
  if (ov) { ov.classList.remove('visible'); setTimeout(() => { ov.style.display = 'none'; }, 300); }
  document.body.style.overflow = '';
}

function renderDayDetails() {
  const titleEl = document.getElementById('day-panel-date');
  const countEl = document.getElementById('day-panel-count');
  const list = document.getElementById('day-tasks-list');
  const dateLabel = new Date(selectedDate + 'T12:00:00').toLocaleDateString('es', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
  titleEl.textContent = dateLabel;
  countEl.textContent = selectedDayTasks.length
    ? `${selectedDayTasks.length} ${selectedDayTasks.length === 1 ? 'evento' : 'eventos'} programado${selectedDayTasks.length === 1 ? '' : 's'}`
    : 'No hay eventos para este día';

  if (!selectedDayTasks.length) {
    list.replaceChildren(createTextElement(
      'div',
      'empty-state',
      'Selecciona otro día del calendario para ver eventos o tareas.'
    ));
    return;
  }

  list.replaceChildren(...selectedDayTasks.map(createCalendarListItem));
}

function renderAgenda() {
  const agenda = document.getElementById('agenda-list');
  const year = calDate.getFullYear();
  const month = String(calDate.getMonth() + 1).padStart(2, '0');
  const monthPrefix = `${year}-${month}-`;
  const items = calendarItems
    .filter(item => normalizeDueDateStr(item.due_date)?.startsWith(monthPrefix))
    .sort((a, b) => a.due_date.localeCompare(b.due_date));

  if (!items.length) {
    agenda.replaceChildren(createTextElement(
      'div',
      'empty-state',
      'No hay eventos programados para este mes.'
    ));
    return;
  }
  agenda.replaceChildren(...items.map(t => {
    const item = document.createElement('div');
    item.className = 'agenda-item';
    item.appendChild(createTextElement('div', 'agenda-item-title', t.title));
    const meta = document.createElement('div');
    meta.className = 'agenda-item-meta';
    meta.appendChild(createTextElement(
      'span',
      '',
      t.due_date
        ? new Date(t.due_date + 'T12:00:00').toLocaleDateString(
            'es',
            { weekday: 'short', day: 'numeric', month: 'short' }
          )
        : 'Sin fecha'
    ));
    appendCalendarBadges(meta, t, true);
    item.appendChild(meta);
    if (t.description) {
      item.appendChild(createTextElement('p', 'day-task-desc', t.description));
    }
    return item;
  }));
}

function createCalendarListItem(task) {
  const article = document.createElement('article');
  article.className = 'day-task-card';
  article.appendChild(createTextElement('div', 'day-task-title', task.title));
  if (task.description) {
    article.appendChild(createTextElement('p', 'day-task-desc', task.description));
  }
  const meta = document.createElement('div');
  meta.className = 'day-task-meta';
  appendCalendarBadges(meta, task, false);
  article.appendChild(meta);
  return article;
}

function appendCalendarBadges(parent, task, agendaView) {
  const google = task._source === 'google';
  parent.appendChild(createTextElement(
    'span',
    `badge ${google ? 'badge-google' : `badge-${task.priority}`}`,
    google ? (agendaView ? 'Google Calendar' : 'Google') : task.priority
  ));
  if (task.label) {
    parent.appendChild(createTextElement('span', 'badge badge-label', `#${task.label}`));
  }
  parent.appendChild(createTextElement(
    'span',
    'badge badge-due',
    google ? (agendaView ? 'Evento' : 'Calendario') :
      (task.status === 'completada' ? 'Completada' : 'Pendiente')
  ));
}

async function goToday() {
