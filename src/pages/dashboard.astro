async function openHistoryModal(taskId) {
  document.getElementById('history-task-id').value = taskId;
  document.getElementById('new-comment-body').value = '';
  setStatusText(document.getElementById('history-changes'), 'Cargando...');
  setStatusText(document.getElementById('history-comments'), 'Cargando...');

  const task = allTasks.find(t => t.id === taskId) || archiveTasks.find(t => t.id === taskId);
  if (task) {
    document.getElementById('edit-priority').value = task.priority || 'media';
    document.getElementById('edit-due-date').value = normalizeDueDateStr(task.due_date) || '';
  }

  document.getElementById('history-modal').classList.add('open');
  await loadHistoryData(taskId);
}

function closeHistoryModal(event) {
  if (event.target === document.getElementById('history-modal')) {
    document.getElementById('history-modal').classList.remove('open');
  }
}

async function loadHistoryData(taskId) {
  try {
    const res  = await fetch(`/api/tasks/${taskId}/history`);
    if (!res.ok) throw new Error('Error al cargar historial');
    const data = await res.json();
    applyHistoryPermissions(data);

    // Cambios automáticos
    const changesEl = document.getElementById('history-changes');
    if (!data.history?.length) {
      setStatusText(changesEl, 'Sin cambios registrados aún.');
    } else {
      changesEl.replaceChildren(...data.history.map(h => {
        const row = document.createElement('div');
        row.style.cssText = 'padding:.3rem 0;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:baseline;gap:.5rem;flex-wrap:wrap';
        const change = document.createElement('span');
        if (h.author_name) {
          const author = createTextElement('span', '', `${h.author_name} · `);
          author.style.cssText = 'color:var(--text2);font-size:.78rem';
          change.appendChild(author);
        }
        const field = createTextElement('span', '', `${h.field}: `);
        field.style.cssText = 'color:var(--accent);font-weight:600';
        const oldValue = createTextElement('span', '', h.old_value || '—');
        oldValue.style.cssText = 'text-decoration:line-through;color:var(--text2);font-size:.8rem';
        const arrow = document.createTextNode(' → ');
        const newValue = createTextElement('strong', '', h.new_value || '—');
        change.append(field, oldValue, arrow, newValue);
        const date = createTextElement('span', '', formatDateShort(h.changed_at));
        date.style.cssText = 'font-size:.74rem;color:var(--text2);white-space:nowrap';
        row.append(change, date);
        return row;
      }));
    }

    // Comentarios
    const commentsEl = document.getElementById('history-comments');
    if (!data.comments?.length) {
      setStatusText(commentsEl, 'Sin comentarios aún.');
    } else {
      commentsEl.replaceChildren(...data.comments.map(c => {
        const card = document.createElement('div');
        card.className = c.kind === 'idea' ? 'comment-idea' : '';
        card.style.cssText = 'padding:.7rem .85rem;background:rgba(255,255,255,0.03);border-radius:10px;border:1px solid var(--border)';

        // En una tarea compartida el autor es la mitad del mensaje.
        const head = document.createElement('div');
        head.style.cssText = 'display:flex;gap:.5rem;align-items:baseline;flex-wrap:wrap;margin-bottom:.3rem';
        head.appendChild(createTextElement(
          'span',
          'comment-author',
          c.author_name || 'Participante'
        ));
        if (c.kind === 'idea') {
          head.appendChild(createTextElement('span', 'comment-kind-tag', '💡 Idea'));
        }
        const date = createTextElement('span', '', formatDateShort(c.created_at));
        date.style.cssText = 'font-size:.75rem;color:var(--text2);margin-left:auto';
        head.appendChild(date);

        const body = createTextElement('div', '', c.body);
        body.style.cssText = 'color:var(--text);line-height:1.5';
        card.append(head, body);
        if (c.ai_reply) {
          const reply = createTextElement('div', '', `🤖 ${c.ai_reply}`);
          reply.style.cssText = 'margin-top:.6rem;padding:.5rem .75rem;background:rgba(124,106,247,0.1);border-left:3px solid var(--accent);border-radius:0 8px 8px 0;font-size:.82rem;color:var(--text);line-height:1.5';
          card.appendChild(reply);
        }
        return card;
      }));
    }
  } catch(err) {
    console.error('Error cargando historial:', err);
    setStatusText(document.getElementById('history-changes'), 'Error al cargar.', true);
  }
}

/**
 * Ajusta el modal al nivel que el servidor reconoce al usuario: un lector no
 * ve la barra de edición rápida ni el cuadro para escribir.
 */
function applyHistoryPermissions(data) {
  const role = data.my_role || 'propietario';
  const level = ROLE_ORDER[role] || 0;

  const quickEdit = document.getElementById('quick-edit-bar');
  if (quickEdit) quickEdit.classList.toggle('hidden', level < ROLE_ORDER.editor);

  const composer = document.getElementById('comment-composer');
  if (composer) composer.classList.toggle('hidden', level < ROLE_ORDER.comentarista);

  const roleTag = document.getElementById('history-role');
  if (roleTag) {
    const participants = (data.participants || []).length;
    roleTag.textContent = participants > 1
      ? `${ROLE_LABELS[role] || role} · ${participants} participantes`
      : ROLE_LABELS[role] || role;
  }
}

function setStatusText(container, message, error = false) {
  const status = createTextElement('em', '', message);
  status.style.color = error ? 'var(--red)' : 'var(--text2)';
  container.replaceChildren(status);
}

// Tipo del próximo aporte: seguimiento normal o idea para el equipo.
let currentCommentKind = 'comentario';

document.querySelectorAll('#comment-kind-toggle .kind-btn').forEach(button => {
  button.addEventListener('click', () => {
    currentCommentKind = button.dataset.kind;
    document.querySelectorAll('#comment-kind-toggle .kind-btn').forEach(other => {
      other.classList.toggle('active', other === button);
    });
    document.getElementById('new-comment-body').placeholder = currentCommentKind === 'idea'
      ? 'Propón una idea al equipo...'
      : 'Escribe tu avance, duda o nota sobre esta tarea...';
  });
});

async function submitComment(askAi) {
  const taskId = document.getElementById('history-task-id').value;
  const body   = document.getElementById('new-comment-body').value.trim();
  if (!body) return;

  const btn = document.getElementById(askAi ? 'btn-comment-ai' : 'btn-comment');
  if (btn) { btn.disabled = true; btn.textContent = askAi ? '⏳ Consultando IA...' : '⏳ Guardando...'; }

  try {
    const res = await fetch(`/api/tasks/${taskId}/comments`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ body, ask_ai: askAi, kind: currentCommentKind }),
    });
    if (!res.ok) {
      const data = await res.json().catch(() => ({}));
      throw new Error(data.error || 'Error al guardar el comentario.');
    }
    document.getElementById('new-comment-body').value = '';
    await loadHistoryData(taskId);
  } catch(err) {
    alert(err?.message || 'Error al guardar el comentario.');
  } finally {
    if (btn) {
      btn.disabled = false;
      btn.textContent = askAi ? '🤖 Comentar + IA' : '💬 Comentar';
    }
  }
}

// ── EQUIPO E INVITACIONES ──

let collabState = { taskId: null, isOwner: false };

async function openCollabModal(taskId) {
  collabState = { taskId, isOwner: false };
  document.getElementById('collab-task-id').value = taskId;
  document.getElementById('collab-error').textContent = '';
  document.getElementById('invite-result').classList.add('hidden');
  document.getElementById('collab-invite-section').classList.add('hidden');
  setStatusText(document.getElementById('collab-participants'), 'Cargando...');

  const task = allTasks.find(t => t.id === taskId) || archiveTasks.find(t => t.id === taskId);
  document.getElementById('collab-task-title').textContent = task?.title || '';

  document.getElementById('collab-modal').classList.add('open');
  await loadCollabData(taskId);
}

function closeCollabModal(event) {
  if (event && event.target !== document.getElementById('collab-modal')) return;
  document.getElementById('collab-modal').classList.remove('open');
}

async function loadCollabData(taskId) {
  try {
    const res = await fetch(`/api/tasks/${taskId}/collaborators`);
    if (!res.ok) throw new Error('No se pudo cargar el equipo de la tarea.');
    const data = await res.json();
    collabState = { taskId, isOwner: Boolean(data.is_owner) };

    document.getElementById('collab-visibility').textContent = data.visibility === 'colaborativa'
      ? `Tarea colaborativa · tú entras como ${ROLE_LABELS[data.my_role] || data.my_role}`
      : 'Tarea privada · solo tú puedes verla';

    renderParticipants(data.participants || [], data);

    const inviteSection = document.getElementById('collab-invite-section');
    inviteSection.classList.toggle('hidden', !data.is_owner);
    if (data.is_owner) await loadInvites(taskId);
  } catch (error) {
    setStatusText(document.getElementById('collab-participants'), error.message, true);
  }
}

function renderParticipants(participants, data) {
  const container = document.getElementById('collab-participants');
  if (!participants.length) {
    setStatusText(container, 'Sin participantes.');
    return;
  }

  container.replaceChildren(...participants.map(person => {
    const row = document.createElement('div');
    row.className = 'collab-row';

    const info = document.createElement('div');
    info.appendChild(createTextElement('div', 'collab-row-name', person.full_name || person.username));
    info.appendChild(createTextElement(
      'div',
      'collab-row-meta',
      ROLE_LABELS[person.role] || person.role
    ));
    row.appendChild(info);

    const actions = document.createElement('div');
    actions.className = 'collab-row-actions';

    // El propietario no se administra a sí mismo: para dejar de compartir se
    // revocan los enlaces o se quita a cada colaborador.
    if (data.is_owner && person.role !== 'propietario') {
      const select = document.createElement('select');
      ['lector', 'comentarista', 'editor'].forEach(role => {
        const option = document.createElement('option');
        option.value = role;
        option.textContent = ROLE_LABELS[role];
        option.selected = role === person.role;
        select.appendChild(option);
      });
      select.addEventListener('change', () => changeRole(person.user_id, select.value));
      actions.appendChild(select);
      actions.appendChild(createActionButton(
        'collab-remove',
        'Quitar',
        () => removeCollaborator(person.user_id, person.full_name)
      ));
    }
    row.appendChild(actions);
    return row;
  }));
}

async function loadInvites(taskId) {
  const container = document.getElementById('collab-invites');
  setStatusText(container, 'Cargando...');

  const res = await fetch(`/api/tasks/${taskId}/invites`);
  if (!res.ok) {
    setStatusText(container, 'No se pudieron cargar los enlaces.', true);
    return;
  }
  const { invites } = await res.json();
  const active = invites.filter(invite => invite.active);

  if (!active.length) {
    setStatusText(container, 'No hay enlaces activos.');
    return;
  }

  container.replaceChildren(...active.map(invite => {
    const row = document.createElement('div');
    row.className = 'collab-row';

    const info = document.createElement('div');
    info.appendChild(createTextElement(
      'div',
      'collab-row-name',
      `Enlace de ${ROLE_LABELS[invite.role] || invite.role}`
    ));
    const usos = invite.max_uses > 0
      ? `${invite.uses}/${invite.max_uses} usos`
      : `${invite.uses} usos`;
    info.appendChild(createTextElement(
      'div',
      'collab-row-meta',
      `Caduca el ${formatDateShort(invite.expires_at)} · ${usos}`
    ));
    row.appendChild(info);

    const actions = document.createElement('div');
    actions.className = 'collab-row-actions';
    actions.appendChild(createActionButton(
      'collab-remove',
      'Revocar',
      () => revokeInvite(invite.id)
    ));
    row.appendChild(actions);
    return row;
  }));
}

async function createInvite() {
  const taskId = collabState.taskId;
  const button = document.getElementById('btn-create-invite');
  const errorEl = document.getElementById('collab-error');
  errorEl.textContent = '';
  button.disabled = true;
  button.textContent = '⏳ Generando...';

  try {
    const res = await fetch(`/api/tasks/${taskId}/invites`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        role: document.getElementById('invite-role').value,
        expires_in_days: Number(document.getElementById('invite-days').value),
        max_uses: Number(document.getElementById('invite-uses').value),
      }),
    });
    const data = await res.json();
    if (!res.ok) throw new Error(data.error || 'No se pudo generar el enlace.');

    // Primero se refresca el panel (que oculta el resultado anterior) y solo
    // después se muestra el enlace nuevo, o quedaría escondido al instante.
    await loadCollabData(taskId);
    await loadTasks();
    document.getElementById('invite-link').value = data.url;
    document.getElementById('invite-result').classList.remove('hidden');
  } catch (error) {
    errorEl.textContent = error.message;
  } finally {
    button.disabled = false;
    button.textContent = '🔗 Generar enlace de invitación';
  }
}

async function copyInviteLink() {
  const input = document.getElementById('invite-link');
  input.select();
  try {
    await navigator.clipboard.writeText(input.value);
    document.getElementById('collab-error').textContent = '';
  } catch {
    // Sin permiso de portapapeles el texto queda seleccionado para copiarlo a mano.
    document.getElementById('collab-error').textContent =
      'No se pudo copiar automáticamente; el enlace está seleccionado.';
  }
}

async function revokeInvite(inviteId) {
  if (!confirm('¿Revocar este enlace? Quien aún no lo haya usado no podrá entrar.')) return;
  const taskId = collabState.taskId;
  const res = await fetch(`/api/tasks/${taskId}/invites/${inviteId}`, { method: 'DELETE' });
  if (!res.ok) {
    document.getElementById('collab-error').textContent = 'No se pudo revocar el enlace.';
    return;
  }
  await loadInvites(taskId);
}

async function changeRole(userId, role) {
  const taskId = collabState.taskId;
  const res = await fetch(`/api/tasks/${taskId}/collaborators/${userId}`, {
    method: 'PATCH',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ role }),
  });
  if (!res.ok) {
    document.getElementById('collab-error').textContent = 'No se pudo cambiar el nivel.';
    return;
  }
  await loadCollabData(taskId);
}

async function removeCollaborator(userId, name) {
  if (!confirm(`¿Quitar a ${name || 'este colaborador'} de la tarea?`)) return;
  const taskId = collabState.taskId;
  const res = await fetch(`/api/tasks/${taskId}/collaborators/${userId}`, { method: 'DELETE' });
  if (!res.ok) {
    document.getElementById('collab-error').textContent = 'No se pudo quitar al colaborador.';
    return;
  }
  await Promise.all([loadCollabData(taskId), loadTasks()]);
}

async function saveQuickEdit() {
  const taskId   = document.getElementById('history-task-id').value;
  const priority = document.getElementById('edit-priority').value;
  const due_date = document.getElementById('edit-due-date').value || null;

  await fetch(`/api/tasks/${taskId}`, {
    method: 'PATCH',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ priority, due_date }),
  });
  document.getElementById('history-modal').classList.remove('open');
  loadTasks();
  if (currentView === 'archive') loadArchive();
}

async function unarchiveTask(id) {
  const response = await fetch(`/api/tasks/${id}`, {
    method: 'PATCH',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ archived: false }),
  });
  if (!response.ok) {
    console.error('No se pudo reabrir la tarea archivada.');
    return;
  }
  await Promise.all([loadArchive(), loadTasks()]);
}

function formatDateShort(dateStr) {
  if (!dateStr) return '';
  try {
    return new Date(dateStr).toLocaleString('es-SV', {
      day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit'
    });
  } catch { return dateStr; }
}

window.openHistoryModal  = openHistoryModal;
window.closeHistoryModal = closeHistoryModal;
window.openCollabModal   = openCollabModal;
window.closeCollabModal  = closeCollabModal;
window.createInvite      = createInvite;
window.copyInviteLink    = copyInviteLink;
window.submitComment     = submitComment;
window.saveQuickEdit     = saveQuickEdit;
window.unarchiveTask     = unarchiveTask;
window.closeSidebar      = closeSidebar;
window.toggleSidebar     = toggleSidebar;
window.closeDayPanel     = closeDayPanel;
window.openDayPanel      = openDayPanel;

[
  ['modal', closeModal],
  ['archive-modal', closeArchiveModal],
  ['history-modal', closeHistoryModal],
  ['collab-modal', closeCollabModal],
].forEach(([id, close]) => {
  const overlay = document.getElementById(id);
  overlay?.addEventListener('click', close);
  overlay?.querySelector('.modal-box')?.addEventListener('click', event => {
    event.stopPropagation();
  });
});

// ── INIT ──
loadTasks();
</script>
