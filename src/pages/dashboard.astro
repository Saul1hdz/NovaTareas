function normalizeDueDateStr(due_date) {
  if (!due_date) return null;
  const s = String(due_date);
  if (/^\d{4}-\d{2}-\d{2}$/.test(s)) return s;
  const num = Number(s);
  if (!isNaN(num) && num > 1000000000000) {
    return new Date(num).toISOString().split('T')[0];
  }
  return null;
}

