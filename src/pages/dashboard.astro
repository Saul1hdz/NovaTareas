// ── PRIORITY ADVISOR ──
function updateAdvisor(tasks) {
  const advisor   = document.getElementById('priority-advisor');
  const taskEl    = document.getElementById('advisor-task');
  const reasonEl  = document.getElementById('advisor-reason');
  const scoreEl   = document.getElementById('advisor-score');

  // Solo considerar tareas pendientes no archivadas
  const pending = tasks.filter(t => t.status !== 'completada');

  if (!pending.length) {
    advisor.classList.add('hidden');
    return;
  }
  advisor.classList.remove('hidden');

  const today    = new Date();
  today.setHours(0, 0, 0, 0);

  // Contar cuántas tareas hay por fecha (para penalizar días saturados)
  const tasksByDate = {};
  pending.forEach(t => {
    const d = normalizeDueDateStr(t.due_date);
    if (d) tasksByDate[d] = (tasksByDate[d] || 0) + 1;
  });

  // Pesos base por prioridad
  const priorityScore = { urgente: 100, alta: 60, media: 30, baja: 10 };

  const scored = pending.map(t => {
    let score = priorityScore[t.priority] || 30;
    let reasons = [];

    const dateStr = normalizeDueDateStr(t.due_date);
    if (dateStr) {
      const due     = new Date(dateStr + 'T00:00:00');
      const diffMs  = due - today;
      const diffDays = Math.ceil(diffMs / (1000 * 60 * 60 * 24));

      if (diffDays < 0) {
        // Vencida
        score += 80 + Math.abs(diffDays) * 5;
        reasons.push(`vencida hace ${Math.abs(diffDays)} día${Math.abs(diffDays) !== 1 ? 's' : ''}`);
      } else if (diffDays === 0) {
        score += 70;
        reasons.push('vence hoy');
      } else if (diffDays === 1) {
        score += 50;
        reasons.push('vence mañana');
      } else if (diffDays <= 3) {
        score += 30;
        reasons.push(`vence en ${diffDays} días`);
      } else if (diffDays <= 7) {
        score += 15;
        reasons.push(`vence en ${diffDays} días`);
      }

      // Penalizar si ese día ya tiene muchas otras tareas (saturación)
      const sameDayCount = tasksByDate[dateStr] || 0;
      if (sameDayCount > 3) {
        score += 10; // ese día está saturado, priorizarlo más
        reasons.push(`día con ${sameDayCount} tareas`);
      }
    } else {
      // Sin fecha: pequeño boost si es urgente para que no quede enterrada
      if (t.priority === 'urgente') reasons.push('urgente sin fecha');
    }

    return { task: t, score, reason: reasons.join(' · ') };
  });

  // Ordenar por score descendente
  scored.sort((a, b) => b.score - a.score);
  const top = scored[0];

  taskEl.textContent   = top.task.title;
  reasonEl.textContent = top.reason || `Prioridad ${top.task.priority}`;
  scoreEl.textContent  = `Score ${top.score}`;
  scoreEl.className    = `advisor-badge ${top.task.priority}`;
}

