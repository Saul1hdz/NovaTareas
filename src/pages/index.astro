---
import Base from '../layouts/Base.astro';
import { getUser } from '../lib/auth.js';

const user = await getUser(Astro.request);
if (user) return Astro.redirect('/dashboard');
---
<Base title="Iniciar sesión">
  <div class="auth-page">
    <div class="auth-bg">
      <div class="orb orb1"></div>
      <div class="orb orb2"></div>
      <div class="grid-lines"></div>
    </div>
    <div class="auth-card" id="auth-card">

      <div class="logo">
        <span class="logo-icon">✦</span>
        <span>NovaTareas</span>
        <span class="logo-pro">PRO</span>
      </div>

      <!-- ── TABS ── -->
      <div class="tabs" id="main-tabs">
        <button class="tab active" id="tab-login" onclick="switchTab('login')">Iniciar sesión</button>
        <button class="tab" id="tab-register" onclick="switchTab('register')">Registrarse</button>
      </div>

      <!-- ══ LOGIN ══ -->
      <form id="form-login" class="auth-form active">
        <div class="field">
          <label>Correo electrónico</label>
          <input type="email" name="email" placeholder="correo@ejemplo.com" required autocomplete="email" />
        </div>
        <div class="field">
          <label>Contraseña</label>
          <input type="password" name="password" placeholder="••••••••" required autocomplete="current-password" />
        </div>
        <div id="login-error" class="error-msg"></div>
        <button type="submit" class="btn-primary">Entrar →</button>
        <button type="button" class="btn-link" onclick="switchTab('recover')">¿Olvidaste tu contraseña?</button>
      </form>

      <!-- ══ REGISTRO ══ -->
      <form id="form-register" class="auth-form">
        <div class="field">
          <label>Nombre completo <span class="req">*</span></label>
          <input type="text" name="full_name" placeholder="Juan Pérez" required autocomplete="name" />
        </div>
        <div class="field">
          <label>Correo electrónico <span class="req">*</span></label>
          <input type="email" name="email" placeholder="correo@ejemplo.com" required autocomplete="email" />
        </div>
        <div class="field">
          <label>Teléfono <span class="req">*</span></label>
          <input type="tel" name="telefono" placeholder="+50312345678" required autocomplete="tel" />
          <small class="hint">Formato internacional, ej: +50312345678</small>
        </div>
        <div class="field">
          <label>Contraseña <span class="req">*</span></label>
          <input type="password" name="password" placeholder="Mín. 8 caracteres con letras y números" required autocomplete="new-password" />
        </div>
        <div class="field">
          <label>Tipo de usuario <span class="req">*</span></label>
          <select name="user_type" required>
            <option value="" disabled selected>Selecciona una opción</option>
            <option value="estudiante">🎓 Estudiante</option>
            <option value="empleado">💼 Empleado</option>
            <option value="comun">👤 Usuario común</option>
          </select>
        </div>

        <div id="register-error" class="error-msg"></div>
        <button type="submit" class="btn-primary">Crear cuenta →</button>
      </form>

      <!-- Mensaje cuando el registro exige verificación de correo -->
      <div id="register-pending" class="auth-form" style="display:none">
        <div class="verify-box">
          <div class="verify-icon">📬</div>
          <h3>Revisa tu correo</h3>
          <p id="register-pending-text">Te enviamos un enlace de confirmación. Ábrelo para activar tu cuenta y poder iniciar sesión.</p>
          <button type="button" class="btn-primary" onclick="switchTab('login')">Ir a iniciar sesión</button>
        </div>
      </div>

      <!-- ══ RECUPERAR CONTRASEÑA ══ -->
      <div id="form-recover" class="auth-form">

        <!-- Paso 1: ingresar correo -->
        <div id="recover-step-email">
          <p class="recover-info">Ingresa tu correo y te enviaremos un enlace para restablecer tu contraseña.</p>
          <div class="field">
            <label>Correo electrónico</label>
            <input type="email" id="recover-email" placeholder="correo@ejemplo.com" required />
          </div>
          <div id="recover-error-email" class="error-msg"></div>
          <button class="btn-primary" onclick="requestEmailReset()">Enviar enlace por correo</button>
          <button type="button" class="btn-link" onclick="cancelRecovery()">← Volver al login</button>
        </div>

        <!-- Paso 2: nueva contraseña (tras abrir el enlace del correo) -->
        <div id="recover-step-password" style="display:none">
          <p class="recover-info" style="color:var(--green)">✅ Identidad verificada. Crea tu nueva contraseña.</p>
          <div class="field">
            <label>Nueva contraseña</label>
            <input type="password" id="recover-new-password" placeholder="Mín. 8 caracteres con letras y números" />
          </div>
          <div id="recover-error-password" class="error-msg"></div>
          <button class="btn-primary" onclick="resetPassword()">Restablecer contraseña →</button>
          <button type="button" class="btn-link" onclick="cancelRecovery()">← Volver al login</button>
        </div>

      </div>

    </div>
  </div>
</Base>

<style>
.auth-page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  padding: 2rem 1rem;
}
.auth-bg { position: fixed; inset: 0; pointer-events: none; }
.orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(80px);
  opacity: 0.15;
}
.orb1 { width: 500px; height: 500px; background: var(--accent); top: -100px; left: -100px; animation: float 8s ease-in-out infinite; }
.orb2 { width: 400px; height: 400px; background: var(--green); bottom: -100px; right: -100px; animation: float 10s ease-in-out infinite reverse; }
.grid-lines {
  position: absolute; inset: 0;
  background-image: linear-gradient(var(--border) 1px, transparent 1px), linear-gradient(90deg, var(--border) 1px, transparent 1px);
  background-size: 48px 48px; opacity: 0.3;
}
@keyframes float {
  0%, 100% { transform: translateY(0) scale(1); }
  50% { transform: translateY(-30px) scale(1.05); }
}
.auth-card {
  background: var(--bg2);
  border: 1px solid var(--border);
  border-radius: 20px;
  padding: 2rem 2rem 2.5rem;
  width: 100%;
  max-width: 460px;
  position: relative;
  z-index: 1;
  box-shadow: var(--card-shadow);
  max-height: 90vh;
  overflow-y: auto;
}
.logo {
  display: flex; align-items: center; gap: 0.5rem;
  font-size: 1.5rem; font-weight: 800; margin-bottom: 1.5rem; justify-content: center;
}
.logo-icon { color: var(--accent); font-size: 1.8rem; }
.logo-pro {
  font-size: 0.65rem; background: var(--accent); color: white;
  padding: 2px 6px; border-radius: 4px; font-weight: 700;
  letter-spacing: 0.05em; align-self: flex-start; margin-top: 4px;
}
.tabs {
  display: flex; gap: 0; background: var(--bg3);
  border-radius: 10px; padding: 4px; margin-bottom: 1.5rem;
}
.tab {
  flex: 1; padding: 0.6rem; border: none !important;
  background: transparent !important; color: var(--text2) !important;
  border-radius: 8px !important; cursor: pointer; font-weight: 600;
  font-size: 0.9rem; transition: all 0.2s;
}
.tab.active { background: var(--bg2) !important; color: var(--text) !important; box-shadow: 0 2px 8px rgba(0,0,0,0.2); }
.auth-form { display: none; flex-direction: column; gap: 0.85rem; }
.auth-form.active { display: flex; }
.field { display: flex; flex-direction: column; gap: 0.35rem; }
.field label {
  font-size: 0.78rem; font-weight: 700; color: var(--text2);
  text-transform: uppercase; letter-spacing: 0.05em;
}
.field input, .field select {
  background: var(--bg3); border: 1px solid var(--border);
  border-radius: 10px; padding: 0.75rem 1rem; color: var(--text);
  outline: none; transition: border-color 0.2s;
}
.field input:focus, .field select:focus { border-color: var(--accent); }
.hint { font-size: 0.75rem; color: var(--text3); }
.req { color: var(--red); }
.error-msg { color: var(--red); font-size: 0.82rem; min-height: 1em; }
.btn-primary {
  background: var(--accent) !important; color: white !important;
  border: none !important; border-radius: 10px !important;
  padding: 0.8rem !important; font-weight: 700; font-size: 1rem;
  cursor: pointer; transition: opacity 0.2s, transform 0.1s; margin-top: 0.25rem;
}
.btn-primary:hover { opacity: 0.9; transform: translateY(-1px); }
.btn-secondary {
  background: var(--bg3) !important; color: var(--text) !important;
  border: 1px solid var(--border) !important; border-radius: 10px !important;
  padding: 0.8rem !important; font-weight: 600; font-size: 0.95rem;
  cursor: pointer; transition: opacity 0.2s; width: 100%;
}
.btn-secondary:hover { opacity: 0.85; }
.verify-box {
  background: var(--bg3); border: 1px solid var(--accent);
  border-radius: 12px; padding: 1.25rem; text-align: center;
  display: flex; flex-direction: column; gap: 0.75rem; align-items: center;
}
.verify-icon { font-size: 2rem; }
.verify-box h3 { margin: 0; color: var(--text); }
.verify-box p { margin: 0; font-size: 0.9rem; color: var(--text2); line-height: 1.5; }
.btn-link {
  background: none !important; border: none !important;
  color: var(--accent) !important; font-size: 0.85rem;
  cursor: pointer; text-align: center; padding: 0.25rem !important;
  text-decoration: underline;
}
.recover-info { font-size: 0.88rem; color: var(--text2); line-height: 1.5; }
</style>

<script>
/**
 * Destino tras autenticarse. Solo se acepta `?next=/unirse/<token>`, que es el
 * único caso real: alguien abrió un enlace de invitación sin sesión iniciada.
 * Cualquier otro valor se ignora para no convertir el login en un redirector
 * abierto hacia sitios externos.
 */
function nextDestination(): string {
  const next = new URLSearchParams(window.location.search).get('next') || '';
  return /^\/unirse\/[A-Za-z0-9_%-]{16,200}$/.test(next) ? next : '/dashboard';
}

function switchTab(tab: 'login' | 'register' | 'recover') {
  ['login','register','recover'].forEach(t => {
    document.getElementById('tab-login')?.classList.toggle('active', t === 'login' && tab === 'login');
    document.getElementById('tab-register')?.classList.toggle('active', t === 'register' && tab === 'register');
    const form = document.getElementById('form-' + t);
    if (form) form.classList.toggle('active', t === tab);
  });

  // Al cambiar de pestaña, oculta el mensaje de verificación pendiente si estaba visible.
  const pending = document.getElementById('register-pending');
  if (pending) {
    pending.classList.remove('active');
    pending.style.display = 'none';
  }

  const tabs = document.getElementById('main-tabs');
  if (tabs) tabs.style.display = tab === 'recover' ? 'none' : '';
}

// ── LOGIN ──────────────────────────────────────────────────────────────────
async function handleLogin(e: SubmitEvent) {
  e.preventDefault();
  const form = e.currentTarget as HTMLFormElement & {
    email: HTMLInputElement;
    password: HTMLInputElement;
  };
  const btn = form.querySelector<HTMLButtonElement>('button[type=submit]');
  const err = document.getElementById('login-error');
  btn.disabled = true; btn.textContent = 'Entrando...'; err.textContent = '';

  try {
    const res = await fetch('/api/login', {
      method: 'POST',
      credentials: 'include',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email: form.email.value, password: form.password.value })
    });
    const data = await res.json();
    if (data.ok) { window.location.href = nextDestination(); }
    else { err.textContent = data.error || 'Error al iniciar sesión'; }
  } catch { err.textContent = 'Error de red'; }
  btn.disabled = false; btn.textContent = 'Entrar →';
}

// ── REGISTRO ───────────────────────────────────────────────────────────────
async function handleRegister(e: SubmitEvent) {
  e.preventDefault();
  const form = e.currentTarget as HTMLFormElement & {
    full_name: HTMLInputElement;
    email: HTMLInputElement;
    telefono: HTMLInputElement;
    password: HTMLInputElement;
    user_type: HTMLSelectElement;
  };
  const btn = form.querySelector<HTMLButtonElement>('button[type=submit]');
  const err = document.getElementById('register-error');
  btn.disabled = true; btn.textContent = 'Creando...'; err.textContent = '';

  const telefono = form.telefono.value.trim();
  const phoneRegex = /^\+?[1-9]\d{6,14}$/;
  if (!phoneRegex.test(telefono)) {
    err.textContent = 'Teléfono inválido. Usa formato internacional, ej: +50312345678';
    btn.disabled = false; btn.textContent = 'Crear cuenta →'; return;
  }

  const pwd = form.password.value;
  if (!/^(?=.*[a-zA-Z])(?=.*\d).{8,}$/.test(pwd)) {
    err.textContent = 'La contraseña debe tener mínimo 8 caracteres, incluir letras y números.';
    btn.disabled = false; btn.textContent = 'Crear cuenta →'; return;
  }

  try {
    const res = await fetch('/api/register', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        full_name: form.full_name.value,
        email: form.email.value,
        telefono,
        password: pwd,
        user_type: form.user_type.value,
      })
    });
    const data = await res.json();
    if (data.ok && data.pending_verification) {
      // El registro exige confirmar el correo: ocultar formulario y avisar.
      form.style.display = 'none';
      form.classList.remove('active');
      const pending = document.getElementById('register-pending');
      if (pending) {
        pending.classList.add('active');
        pending.style.display = '';
      }
      return;
    }
    if (data.ok) { window.location.href = nextDestination(); }
    else { err.textContent = data.error || 'Error al registrarse'; }
  } catch { err.textContent = 'Error de red'; }
  btn.disabled = false; btn.textContent = 'Crear cuenta →';
}

// ── RECUPERACIÓN ───────────────────────────────────────────────────────────
let recoverEmail = '';
let recoverToken = '';

function cancelRecovery() {
  recoverEmail = '';
  recoverToken = '';
  (document.getElementById('recover-email') as HTMLInputElement).value = '';
  (document.getElementById('recover-new-password') as HTMLInputElement).value = '';
  document.getElementById('recover-step-email').style.display = '';
  document.getElementById('recover-step-password').style.display = 'none';
  document.querySelectorAll('#form-recover .error-msg').forEach(element => {
    element.textContent = '';
  });
  switchTab('login');
}

// Recuperación por correo: envía un enlace de un solo uso al buzón.
async function requestEmailReset() {
  const email = (document.getElementById('recover-email') as HTMLInputElement).value.trim();
  const err = document.getElementById('recover-error-email');
  err.textContent = '';
  const btn = document.querySelector('#recover-step-email .btn-primary') as HTMLButtonElement;

  if (!email) { err.textContent = 'Ingresa tu correo.'; return; }
  btn.disabled = true; btn.textContent = 'Enviando...';

  try {
    const res = await fetch('/api/auth/recover', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ action: 'request_email_reset', email })
    });
    const data = await res.json();
    if (!data.ok) { err.textContent = data.error || 'Error al enviar el enlace.'; return; }
    if (data.via_email === false) {
      err.textContent = 'El envío de correo no está configurado en este servidor.';
      return;
    }
    err.textContent = '📬 Si existe una cuenta con ese correo, te enviamos un enlace de recuperación.';
  } catch { err.textContent = 'Error de red'; }
  btn.disabled = false; btn.textContent = 'Enviar enlace por correo';
}

async function resetPassword() {
  const pwd = (document.getElementById('recover-new-password') as HTMLInputElement).value;
  const err = document.getElementById('recover-error-password');
  err.textContent = '';

  if (!/^(?=.*[a-zA-Z])(?=.*\d).{8,}$/.test(pwd)) {
    err.textContent = 'Mínimo 8 caracteres con letras y números.'; return;
  }

  const res = await fetch('/api/auth/recover', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ action: 'reset_password', token: recoverToken, new_password: pwd })
  });
  const data = await res.json();

  if (data.ok) {
    alert('✅ Contraseña restablecida. Ahora puedes iniciar sesión.');
    cancelRecovery();
  } else {
    err.textContent = data.error;
  }
}

// Init
declare global {
  interface Window {
    switchTab: (tab: 'login' | 'register' | 'recover') => void;
    requestEmailReset: () => void;
    resetPassword: () => void;
    cancelRecovery: () => void;
  }
}

window.switchTab = switchTab;
document.getElementById('form-login')?.addEventListener('submit', handleLogin);
document.getElementById('form-register')?.addEventListener('submit', handleRegister);
window.requestEmailReset = requestEmailReset;
window.resetPassword = resetPassword;
window.cancelRecovery = cancelRecovery;

// Enlace de recuperación por correo: salta directo al paso de nueva contraseña.
(function initRecoveryToken() {
  const params = new URLSearchParams(window.location.search);
  const token = params.get('recovery_token');
  if (!token) return;
  recoverToken = token;
  recoverEmail = '';
  document.getElementById('recover-step-email').style.display = 'none';
  document.getElementById('recover-step-password').style.display = '';
  switchTab('recover');
  // Limpia el token de la URL sin recargar.
  const url = new URL(window.location.href);
  url.searchParams.delete('recovery_token');
  history.replaceState(null, '', url.toString());
})();
</script>
